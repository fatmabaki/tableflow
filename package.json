{
  "name": "tableflow",
  "version": "0.2.0",
  "private": true,
  "description": "TableFlow - QR table ordering: customer demo + layered Node/PostgreSQL backend",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
