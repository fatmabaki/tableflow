    "dev:db": "node scripts/dev-db.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19"
  }
}
