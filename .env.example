# Copy to .env and fill in. NEVER commit .env or put real secrets in this file.

PORT=5173
NODE_ENV=development

# --- PostgreSQL: either one URL (hosted platforms) ...
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# PGSSL=true            # set true for most hosted databases
# --- ... or discrete settings
PGHOST=localhost
PGPORT=5432
PGUSER=tableflow
PGPASSWORD=change-me
PGDATABASE=tableflow

# Run migrations automatically on boot (handy on hosts without a release step)
RUN_MIGRATIONS_ON_START=false

# --- Resend email (https://resend.com). Without a key, jobs retry and end up "failed".
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=TableFlow <onboarding@resend.dev>
# Optional: staff address that receives a notification for every order
NOTIFY_EMAIL=
EMAIL_MAX_ATTEMPTS=4
EMAIL_RETRY_BASE_MS=30000
EMAIL_WORKER=true

# Allowed browser origin for the API ("*" = any; set your site URL in production if the UI is hosted elsewhere)
CORS_ORIGIN=*

# --- Staff (kitchen) API key. Staff endpoints are disabled when empty.
STAFF_API_KEY=choose-a-long-random-string

# Demo only: auto-move orders received -> preparing -> ready -> served by age (SIMULATED)
DEMO_AUTO_ADVANCE=true
